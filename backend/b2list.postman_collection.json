    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Obter Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Salva o token em uma variável para usar em outras requisições",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('jwt_token', jsonData.accessToken);",
                  "    pm.environment.set('username', jsonData.username);",
                  "    pm.environment.set('tenantCode', jsonData.tenantCode);",
                  "    console.log('Token armazenado com sucesso!');",
                  "    console.log('Token: ' + jsonData.accessToken.substring(0, 50) + '...');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@b2list.com\",\n  \"password\": \"senha123\",\n  \"tenantCode\": \"TEN002\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Faça login para obter um token JWT. O token será automaticamente salvo nas variáveis de ambiente."
          },
          "response": []
        },
        {
